# ==========================================
# Build Outputs & Gradle Caches
# ==========================================
.gradle/
build/
app/build/
core-engine/build/
**/build/

# Package Files / Android Outputs
*.apk
*.aab
*.aar
*.jar

# ==========================================
# Android & Environment Local Configs
# ==========================================
# Contains SDK paths specific to your machine
local.properties

# Android Profiling & Captures
captures/
.navigation/

# Signing keys & Keystores (NEVER commit these)
*.jks
*.keystore
*.p12
*.pem

# ==========================================
# IDE & Editor Configurations
# ==========================================
# VS Code (Ignore state/cache, keep workspace configs if needed)
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/settings.json
!.vscode/extensions.json
*.code-workspace

# IntelliJ / Android Studio (In case files are generated by Kotlin LSP)
.idea/
*.iml
out/

# Linux / Vim / Emacs Swap & Temp Files
*~
*.swp
*.swo

# OS Generated Files
.DS_Store
Thumbs.db

# ==========================================
# Logs & Environment Files
# ==========================================
*.log
.env
